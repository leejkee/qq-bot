# NODE_ENV 默认 development；生产由 systemd 设置，请在生产 .env 中省略。
# 生产目录依次为 /etc/qq-bot、/var/lib/qq-bot、/var/log/qq-bot
QQBOT_CONFIG_DIR=./config
QQBOT_DATA_DIR=./data
QQBOT_LOG_DIR=./logs

# QQ 开放平台应用 ID、密钥与沙箱开关
BOT_APPID=
BOT_SECRET=
BOT_SANDBOX=true

# 模型接口 HTTPS 地址、模型名称与访问密钥
LLM_CHAT_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=
LLM_API_KEY=
# 启用 DeepSeek 官方联网搜索
LLM_WEB_SEARCH=false
