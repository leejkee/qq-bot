    "start": "node dist/index.js",
    "probe": "node dist/index.js --console-probe"
  },
  "dependencies": {
    "qq-official-bot": "1.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
